# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database — leave MONGODB_URI empty to use in-memory MongoDB (dev only)
MONGODB_URI=
# If "mongodb+srv://" fails with "querySrv ECONNREFUSED" (network blocks DNS SRV lookups),
# set a resolver that supports SRV — or use the non-SRV mongodb:// host-list URI instead.
MONGODB_DNS=

# Auth
JWT_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_COST=12

# Email (dev uses console mock when SMTP_HOST empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="TalentHive <no-reply@talenthive.dev>"

# Storage (dev uses local uploads/ when unset)
# Images: set IMGBB_API_KEY to upload images to ImgBB (https://api.imgbb.com)
STORAGE_PROVIDER=local
IMGBB_API_KEY=
MAX_FILE_MB=10
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI (dev default: mock — no key needed)
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=

# Payments (dev default: mock)
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Dev seed admin (development only)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
